# StockForge Environment Configuration
# Copy to .env and fill in values (all optional)

# NewsAPI key for sentiment analysis (free: 100 req/day)
# NEWSAPI_KEY=

# Angel One API key for real-time quotes (optional, free with account)
# ANGEL_ONE_API_KEY=
# ANGEL_ONE_APP_KEY=
# ANGEL_ONE_USER_ID=

# Default watchlist file path
WATCHLIST_FILE=config/watchlist.txt
